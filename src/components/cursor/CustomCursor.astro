<div class="curzr-arrow-pointer pointer-events-none fixed top-0 left-0 z-[999999] hidden select-none will-change-transform" aria-hidden="true">
  <!-- Origin sits on the arrow tip (y = 1 of the 32-unit viewBox) so the tip is the exact hotspot -->
  <div class="curzr-arrow-inner w-6 h-6 select-none will-change-transform" style="transform-origin: 50% 3.125%;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-full h-full drop-shadow-[0_2px_5px_rgba(0,0,0,0.2)]">
      <path class="inner" d="M25,30a5.82,5.82,0,0,1-1.09-.17l-.2-.07-7.36-3.48a.72.72,0,0,0-.35-.08.78.78,0,0,0-.33.07L8.24,29.54a.66.66,0,0,1-.2.06,5.17,5.17,0,0,1-1,.15,3.6,3.6,0,0,1-3.29-5L12.68,4.2a3.59,3.59,0,0,1,6.58,0l9,20.74A3.6,3.6,0,0,1,25,30Z" fill="#F2F5F8" />
      <path class="outer" d="M16,3A2.59,2.59,0,0,1,18.34,4.6l9,20.74A2.59,2.59,0,0,1,25,29a5.42,5.42,0,0,1-.86-.15l-7.37-3.48a1.84,1.84,0,0,0-.77-.17,1.69,1.69,0,0,0-.73.16l-7.4,3.31a5.89,5.89,0,0,1-.79.12,2.59,2.59,0,0,1-2.37-3.62L13.6,4.6A2.58,2.58,0,0,1,16,3m0-2h0A4.58,4.58,0,0,0,11.76,3.8L2.84,24.33A4.58,4.58,0,0,0,7,30.75a6.08,6.08,0,0,0,1.21-.17,1.87,1.87,0,0,0,.4-.13L16,27.18l7.29,3.44a1.64,1.64,0,0,0,.39.14A6.37,6.37,0,0,0,25,31a4.59,4.59,0,0,0,4.21-6.41l-9-20.75A4.62,4.62,0,0,0,16,1Z" fill="#111920" />
    </svg>
  </div>
</div>

<style>
  /* Guaranteed hide on touch/mobile devices */
  @media (pointer: coarse), (hover: none) {
    .curzr-arrow-pointer {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }

  .curzr-arrow-pointer {
    opacity: 0;
    transition: opacity 150ms ease-out;
  }

  .curzr-arrow-pointer.is-visible {
    opacity: 1;
  }

  .curzr-arrow-inner {
    transition: transform 90ms ease-out;
  }

  /* Settling back upright after the pointer stops is slower and springier */
  .curzr-arrow-inner.is-settling {
    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>

<script>
  const HOVER_SELECTOR = 'a, button, select, [role="button"], #character-avatar-container, .curzr-hover';
  // Over text fields the native I-beam is shown instead of the arrow (see global.css)
  const TEXT_SELECTOR = 'input:not([type="button"]):not([type="submit"]):not([type="checkbox"]):not([type="radio"]), textarea, [contenteditable="true"]';
  const IDLE_MS = 140;
  const MIN_STEP_PX = 3;

  // Smallest signed difference between two angles, in degrees (-180..180]
  const shortestDelta = (from: number, to: number) => {
    const d = (((to - from) % 360) + 540) % 360 - 180;
    return d === -180 ? 180 : d;
  };

  class ArrowPointer {
    wrapper: HTMLElement;
    inner: HTMLElement;
    rotates: boolean;
    lastX = 0;
    lastY = 0;
    hasPosition = false;
    angle = 0;
    scale = 1;
    idleTimer: number | undefined;

    constructor(wrapper: HTMLElement, inner: HTMLElement, rotates: boolean) {
      this.wrapper = wrapper;
      this.inner = inner;
      this.rotates = rotates;
      this.wrapper.classList.remove('hidden');
      this.render();
    }

    render() {
      this.inner.style.transform = `translate(-50%, -3.125%) rotate(${this.angle}deg) scale(${this.scale})`;
    }

    move(x: number, y: number) {
      this.wrapper.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      // Stay invisible until the first real position is known, so the arrow never flashes at 0,0
      if (!this.hasPosition) {
        this.hasPosition = true;
        this.lastX = x;
        this.lastY = y;
        this.show();
        return;
      }

      const dx = x - this.lastX;
      const dy = y - this.lastY;
      if (this.rotates && Math.hypot(dx, dy) >= MIN_STEP_PX) {
        // 0deg = arrow pointing up, clockwise positive
        const heading = Math.atan2(dx, -dy) * (180 / Math.PI);
        this.inner.classList.remove('is-settling');
        this.angle += shortestDelta(this.angle, heading);
        this.render();
        this.lastX = x;
        this.lastY = y;
      }

      window.clearTimeout(this.idleTimer);
      this.idleTimer = window.setTimeout(() => this.settle(), IDLE_MS);
    }

    // Fully return to upright via the shortest turn once the pointer rests
    settle() {
      const target = Math.round(this.angle / 360) * 360;
      if (target === this.angle) return;
      this.inner.classList.add('is-settling');
      this.angle = target;
      this.render();
    }

    setHover(isHover: boolean) {
      this.scale = isHover ? 1.35 : 1;
      this.render();
    }

    press() {
      const restScale = this.scale;
      this.scale = restScale * 0.85;
      this.render();
      window.setTimeout(() => {
        this.scale = restScale;
        this.render();
      }, 90);
    }

    show() {
      if (this.hasPosition) this.wrapper.classList.add('is-visible');
    }

    hide() {
      this.wrapper.classList.remove('is-visible');
    }
  }

  // Explicit check to disable completely on Android & touch devices
  const isTouchOrMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches && !isTouchOrMobile;
  const wrapper = document.querySelector<HTMLElement>('.curzr-arrow-pointer');
  const inner = document.querySelector<HTMLElement>('.curzr-arrow-inner');

  if (isFinePointer && wrapper && inner) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const arrow = new ArrowPointer(wrapper, inner, !reduceMotion);
    document.documentElement.classList.add('has-custom-cursor');

    window.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      arrow.move(e.clientX, e.clientY);
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') arrow.press();
    });

    // Delegated, so elements rendered later (form status links, etc.) are covered too
    document.addEventListener('pointerover', (e) => {
      const target = e.target as Element | null;
      if (!target?.closest) return;
      if (target.closest(TEXT_SELECTOR)) {
        arrow.hide();
        return;
      }
      arrow.show();
      arrow.setHover(!!target.closest(HOVER_SELECTOR));
    });

    document.documentElement.addEventListener('mouseleave', () => arrow.hide());
    document.documentElement.addEventListener('mouseenter', () => arrow.show());
  }
</script>
