<div class="curzr-arrow-pointer pointer-events-none fixed top-0 left-0 z-[999999] hidden select-none will-change-transform" aria-hidden="true">
  <div class="curzr-arrow-inner w-6 h-6 select-none will-change-transform transition-transform duration-75 ease-out" style="transform-origin: 50% 20%;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-full h-full drop-shadow-[0_2px_5px_rgba(0,0,0,0.2)]">
      <path class="inner" d="M25,30a5.82,5.82,0,0,1-1.09-.17l-.2-.07-7.36-3.48a.72.72,0,0,0-.35-.08.78.78,0,0,0-.33.07L8.24,29.54a.66.66,0,0,1-.2.06,5.17,5.17,0,0,1-1,.15,3.6,3.6,0,0,1-3.29-5L12.68,4.2a3.59,3.59,0,0,1,6.58,0l9,20.74A3.6,3.6,0,0,1,25,30Z" fill="#F2F5F8" />
      <path class="outer" d="M16,3A2.59,2.59,0,0,1,18.34,4.6l9,20.74A2.59,2.59,0,0,1,25,29a5.42,5.42,0,0,1-.86-.15l-7.37-3.48a1.84,1.84,0,0,0-.77-.17,1.69,1.69,0,0,0-.73.16l-7.4,3.31a5.89,5.89,0,0,1-.79.12,2.59,2.59,0,0,1-2.37-3.62L13.6,4.6A2.58,2.58,0,0,1,16,3m0-2h0A4.58,4.58,0,0,0,11.76,3.8L2.84,24.33A4.58,4.58,0,0,0,7,30.75a6.08,6.08,0,0,0,1.21-.17,1.87,1.87,0,0,0,.4-.13L16,27.18l7.29,3.44a1.64,1.64,0,0,0,.39.14A6.37,6.37,0,0,0,25,31a4.59,4.59,0,0,0,4.21-6.41l-9-20.75A4.62,4.62,0,0,0,16,1Z" fill="#111920" />
    </svg>
  </div>
</div>

<script>
  class ArrowPointer {
    cursorWrapper: HTMLElement | null;
    cursorInner: HTMLElement | null;
    prevX: number;
    prevY: number;
    angle: number;
    prevAngle: number;
    angleDisplace: number;
    degrees: number;
    scale: number;
    idleTimeout: number | null;

    constructor() {
      this.cursorWrapper = document.querySelector(".curzr-arrow-pointer");
      this.cursorInner = document.querySelector(".curzr-arrow-inner");
      this.prevX = 0;
      this.prevY = 0;
      this.angle = 0;
      this.prevAngle = 0;
      this.angleDisplace = 0;
      this.degrees = 57.296;
      this.scale = 1;
      this.idleTimeout = null;

      if (this.cursorWrapper) {
        this.init();
      }
    }

    init() {
      if (!this.cursorWrapper || !this.cursorInner) return;
      this.cursorWrapper.classList.remove('hidden');
      this.updateInnerTransform();
    }

    updateInnerTransform() {
      if (!this.cursorInner) return;
      this.cursorInner.style.transform = `translate(-50%, -20%) rotate(${this.angleDisplace}deg) scale(${this.scale})`;
    }

    move(event: MouseEvent) {
      if (!this.cursorWrapper) return;

      const clientX = event.clientX;
      const clientY = event.clientY;

      // Instant 1:1 hardware position tracking
      this.cursorWrapper.style.transform = `translate3d(${clientX}px, ${clientY}px, 0)`;

      const dx = this.prevX - clientX;
      const dy = this.prevY - clientY;
      const distance = Math.hypot(dx, dy);

      this.prevX = clientX;
      this.prevY = clientY;

      if (distance > 1.5) {
        this.rotate(dx, dy);
        this.updateInnerTransform();
      }

      // Smooth idle reset towards natural pointer angle
      if (this.idleTimeout) clearTimeout(this.idleTimeout);
      this.idleTimeout = window.setTimeout(() => {
        const targetAngle = 0;
        const diff = (targetAngle - (this.angleDisplace % 360));
        this.angleDisplace += diff * 0.4;
        this.updateInnerTransform();
      }, 150);
    }

    rotate(dx: number, dy: number) {
      const unsortedAngle = Math.atan(Math.abs(dy) / (Math.abs(dx) || 0.0001)) * this.degrees;
      this.prevAngle = this.angle;

      if (dx <= 0 && dy >= 0) {
        this.angle = 90 - unsortedAngle;
      } else if (dx < 0 && dy < 0) {
        this.angle = unsortedAngle + 90;
      } else if (dx >= 0 && dy <= 0) {
        this.angle = 90 - unsortedAngle + 180;
      } else if (dx > 0 && dy > 0) {
        this.angle = unsortedAngle + 270;
      }

      if (!isNaN(this.angle)) {
        if (this.angle - this.prevAngle <= -270) {
          this.angleDisplace += 360 + this.angle - this.prevAngle;
        } else if (this.angle - this.prevAngle >= 270) {
          this.angleDisplace += this.angle - this.prevAngle - 360;
        } else {
          this.angleDisplace += this.angle - this.prevAngle;
        }
      }
    }

    hover() {
      this.scale = 1.35;
      this.updateInnerTransform();
    }

    hoverout() {
      this.scale = 1;
      this.updateInnerTransform();
    }

    click() {
      const prevScale = this.scale;
      this.scale = 0.85;
      this.updateInnerTransform();
      setTimeout(() => {
        this.scale = prevScale;
        this.updateInnerTransform();
      }, 70);
    }

    hide() {
      if (this.cursorWrapper) {
        this.cursorWrapper.style.opacity = '0';
      }
    }

    show() {
      if (this.cursorWrapper) {
        this.cursorWrapper.style.opacity = '1';
      }
    }
  }

  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (isFinePointer) {
    const arrowCursor = new ArrowPointer();

    window.addEventListener('mousemove', (e) => {
      arrowCursor.move(e);
    }, { passive: true });

    window.addEventListener('mousedown', () => {
      arrowCursor.click();
    });

    document.addEventListener('mouseleave', () => {
      arrowCursor.hide();
    });

    document.addEventListener('mouseenter', () => {
      arrowCursor.show();
    });

    // Delegate hover listeners to interactive elements
    const setupInteractiveHover = () => {
      const interactiveSelector = 'a, button, input, textarea, select, [role="button"], [data-avatar-head], #character-avatar-container, .curzr-hover';
      const interactiveEls = document.querySelectorAll(interactiveSelector);
      
      interactiveEls.forEach((el) => {
        el.addEventListener('mouseenter', () => arrowCursor.hover());
        el.addEventListener('mouseleave', () => arrowCursor.hoverout());
      });
    };

    setupInteractiveHover();
    document.addEventListener('astro:page-load', setupInteractiveHover);
  }
</script>
