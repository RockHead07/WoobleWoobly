<div class="curzr-arrow-pointer pointer-events-none fixed z-[99999] hidden select-none" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-full h-full">
    <path class="inner" d="M25,30a5.82,5.82,0,0,1-1.09-.17l-.2-.07-7.36-3.48a.72.72,0,0,0-.35-.08.78.78,0,0,0-.33.07L8.24,29.54a.66.66,0,0,1-.2.06,5.17,5.17,0,0,1-1,.15,3.6,3.6,0,0,1-3.29-5L12.68,4.2a3.59,3.59,0,0,1,6.58,0l9,20.74A3.6,3.6,0,0,1,25,30Z" fill="#F2F5F8" />
    <path class="outer" d="M16,3A2.59,2.59,0,0,1,18.34,4.6l9,20.74A2.59,2.59,0,0,1,25,29a5.42,5.42,0,0,1-.86-.15l-7.37-3.48a1.84,1.84,0,0,0-.77-.17,1.69,1.69,0,0,0-.73.16l-7.4,3.31a5.89,5.89,0,0,1-.79.12,2.59,2.59,0,0,1-2.37-3.62L13.6,4.6A2.58,2.58,0,0,1,16,3m0-2h0A4.58,4.58,0,0,0,11.76,3.8L2.84,24.33A4.58,4.58,0,0,0,7,30.75a6.08,6.08,0,0,0,1.21-.17,1.87,1.87,0,0,0,.4-.13L16,27.18l7.29,3.44a1.64,1.64,0,0,0,.39.14A6.37,6.37,0,0,0,25,31a4.59,4.59,0,0,0,4.21-6.41l-9-20.75A4.62,4.62,0,0,0,16,1Z" fill="#111920" />
  </svg>
</div>

<script>
  class ArrowPointer {
    cursor: HTMLElement | null;
    position: {
      distanceX: number;
      distanceY: number;
      distance: number;
      pointerX: number;
      pointerY: number;
    };
    previousPointerX: number;
    previousPointerY: number;
    angle: number;
    previousAngle: number;
    angleDisplace: number;
    degrees: number;
    cursorSize: number;
    scale: number;

    constructor() {
      this.cursor = document.querySelector(".curzr-arrow-pointer");
      this.position = {
        distanceX: 0,
        distanceY: 0,
        distance: 0,
        pointerX: 0,
        pointerY: 0,
      };
      this.previousPointerX = 0;
      this.previousPointerY = 0;
      this.angle = 0;
      this.previousAngle = 0;
      this.angleDisplace = 0;
      this.degrees = 57.296;
      this.cursorSize = 24;
      this.scale = 1;

      if (this.cursor) {
        this.init();
      }
    }

    init() {
      if (!this.cursor) return;
      
      const style = {
        boxSizing: 'border-box',
        position: 'fixed',
        top: '0px',
        left: '0px',
        zIndex: '99999',
        width: `${this.cursorSize}px`,
        height: `${this.cursorSize}px`,
        transition: 'opacity 200ms ease, filter 200ms ease',
        userSelect: 'none',
        pointerEvents: 'none',
        opacity: '0',
        transformOrigin: 'center center',
        filter: 'drop-shadow(0 2px 4px rgba(0,0,0,0.15))'
      };

      Object.assign(this.cursor.style, style);
      this.cursor.classList.remove('hidden');
      setTimeout(() => {
        if (this.cursor) this.cursor.style.opacity = '1';
      }, 100);
    }

    move(event: MouseEvent) {
      if (!this.cursor) return;

      this.previousPointerX = this.position.pointerX;
      this.previousPointerY = this.position.pointerY;
      this.position.pointerX = event.clientX;
      this.position.pointerY = event.clientY;
      this.position.distanceX = this.previousPointerX - this.position.pointerX;
      this.position.distanceY = this.previousPointerY - this.position.pointerY;
      this.position.distance = Math.sqrt(this.position.distanceY ** 2 + this.position.distanceX ** 2);

      if (this.position.distance > 1) {
        this.rotate(this.position);
      }

      this.cursor.style.transform = `translate3d(${this.position.pointerX - this.cursorSize / 2}px, ${this.position.pointerY - this.cursorSize / 2}px, 0) rotate(${this.angleDisplace}deg) scale(${this.scale})`;
    }

    rotate(position: { distanceX: number; distanceY: number }) {
      const unsortedAngle = Math.atan(Math.abs(position.distanceY) / (Math.abs(position.distanceX) || 0.0001)) * this.degrees;
      this.previousAngle = this.angle;

      if (position.distanceX <= 0 && position.distanceY >= 0) {
        this.angle = 90 - unsortedAngle;
      } else if (position.distanceX < 0 && position.distanceY < 0) {
        this.angle = unsortedAngle + 90;
      } else if (position.distanceX >= 0 && position.distanceY <= 0) {
        this.angle = 90 - unsortedAngle + 180;
      } else if (position.distanceX > 0 && position.distanceY > 0) {
        this.angle = unsortedAngle + 270;
      }

      if (!isNaN(this.angle)) {
        if (this.angle - this.previousAngle <= -270) {
          this.angleDisplace += 360 + this.angle - this.previousAngle;
        } else if (this.angle - this.previousAngle >= 270) {
          this.angleDisplace += this.angle - this.previousAngle - 360;
        } else {
          this.angleDisplace += this.angle - this.previousAngle;
        }
      }
    }

    hover() {
      this.scale = 1.3;
      if (this.cursor) {
        this.cursor.style.filter = 'drop-shadow(0 4px 12px rgba(99, 102, 241, 0.45))';
      }
    }

    hoverout() {
      this.scale = 1;
      if (this.cursor) {
        this.cursor.style.filter = 'drop-shadow(0 2px 4px rgba(0,0,0,0.15))';
      }
    }

    click() {
      if (!this.cursor) return;
      const prevScale = this.scale;
      this.scale = 0.8;
      this.cursor.style.transform = `translate3d(${this.position.pointerX - this.cursorSize / 2}px, ${this.position.pointerY - this.cursorSize / 2}px, 0) rotate(${this.angleDisplace}deg) scale(${this.scale})`;
      setTimeout(() => {
        this.scale = prevScale;
        if (this.cursor) {
          this.cursor.style.transform = `translate3d(${this.position.pointerX - this.cursorSize / 2}px, ${this.position.pointerY - this.cursorSize / 2}px, 0) rotate(${this.angleDisplace}deg) scale(${this.scale})`;
        }
      }, 70);
    }

    hide() {
      if (this.cursor) {
        this.cursor.style.opacity = '0';
      }
    }

    show() {
      if (this.cursor) {
        this.cursor.style.opacity = '1';
      }
    }
  }

  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (isFinePointer) {
    const arrowCursor = new ArrowPointer();

    window.addEventListener('mousemove', (e) => {
      arrowCursor.move(e);
    }, { passive: true });

    window.addEventListener('mousedown', () => {
      arrowCursor.click();
    });

    document.addEventListener('mouseleave', () => {
      arrowCursor.hide();
    });

    document.addEventListener('mouseenter', () => {
      arrowCursor.show();
    });

    // Delegate hover listeners to support dynamically loaded or refreshed content
    const setupInteractiveHover = () => {
      const interactiveSelector = 'a, button, input, textarea, select, [role="button"], [data-avatar-head], .curzr-hover';
      const interactiveEls = document.querySelectorAll(interactiveSelector);
      
      interactiveEls.forEach((el) => {
        el.addEventListener('mouseenter', () => arrowCursor.hover());
        el.addEventListener('mouseleave', () => arrowCursor.hoverout());
      });
    };

    setupInteractiveHover();
    document.addEventListener('astro:page-load', setupInteractiveHover);
  }
</script>
