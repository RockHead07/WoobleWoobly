---
import { socialLinks } from '../../data/links';

// Helper to determine brand colors and classes
const getBrandClasses = (platform: string) => {
  const p = platform.toLowerCase();
  if (p.includes('github')) {
    return {
      btnHover: 'hover:bg-[#24292e] hover:border-slate-500/60 hover:text-white hover:shadow-[0_10px_25px_rgba(0,0,0,0.6)]',
      tooltipBg: 'bg-[#24292e] border-slate-600/70',
      arrowBg: 'bg-[#24292e]',
    };
  }
  if (p.includes('twitter') || p.includes('x')) {
    return {
      btnHover: 'hover:bg-[#1DA1F2] hover:border-[#1DA1F2]/80 hover:text-white hover:shadow-[0_10px_25px_rgba(29,161,242,0.45)]',
      tooltipBg: 'bg-[#1DA1F2] border-[#1DA1F2]/80',
      arrowBg: 'bg-[#1DA1F2]',
    };
  }
  if (p.includes('linkedin')) {
    return {
      btnHover: 'hover:bg-[#0A66C2] hover:border-[#0A66C2]/80 hover:text-white hover:shadow-[0_10px_25px_rgba(10,102,194,0.45)]',
      tooltipBg: 'bg-[#0A66C2] border-[#0A66C2]/80',
      arrowBg: 'bg-[#0A66C2]',
    };
  }
  if (p.includes('youtube')) {
    return {
      btnHover: 'hover:bg-[#CD201F] hover:border-[#CD201F]/80 hover:text-white hover:shadow-[0_10px_25px_rgba(205,32,31,0.45)]',
      tooltipBg: 'bg-[#CD201F] border-[#CD201F]/80',
      arrowBg: 'bg-[#CD201F]',
    };
  }
  if (p.includes('instagram')) {
    return {
      btnHover: 'hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] hover:border-pink-400/80 hover:text-white hover:shadow-[0_10px_25px_rgba(220,39,67,0.45)]',
      tooltipBg: 'bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] border-pink-400/80',
      arrowBg: 'bg-[#dc2743]',
    };
  }
  if (p.includes('facebook')) {
    return {
      btnHover: 'hover:bg-[#1877F2] hover:border-[#1877F2]/80 hover:text-white hover:shadow-[0_10px_25px_rgba(24,119,242,0.45)]',
      tooltipBg: 'bg-[#1877F2] border-[#1877F2]/80',
      arrowBg: 'bg-[#1877F2]',
    };
  }
  return {
    btnHover: 'hover:bg-indigo-600 hover:border-indigo-400 hover:text-white hover:shadow-[0_10px_25px_rgba(99,102,241,0.45)]',
    tooltipBg: 'bg-indigo-600 border-indigo-400',
    arrowBg: 'bg-indigo-600',
  };
};
---

<div class="flex items-center justify-center gap-3 sm:gap-3.5 py-3 flex-wrap">
  {socialLinks.map((item) => {
    const brand = getBrandClasses(item.platform);
    return (
      <div class="relative group/social flex flex-col items-center">
        <!-- Floating Tooltip with Bounce Animation -->
        <div class="absolute -top-3 opacity-0 pointer-events-none group-hover/social:-top-9.5 group-hover/social:opacity-100 transition-all duration-300 ease-[cubic-bezier(0.68,-0.55,0.265,1.55)] z-30 flex flex-col items-center select-none">
          <div class={`px-2.5 py-1 rounded-md text-[11px] font-bold text-white shadow-xl backdrop-blur-md border ${brand.tooltipBg} tracking-wide whitespace-nowrap shadow-black/40`}>
            {item.platform}
          </div>
          <!-- Tooltip bottom triangle pointer -->
          <div class={`w-2 h-2 rotate-45 -mt-1 border-r border-b ${brand.arrowBg} border-white/20`}></div>
        </div>

        <!-- Glassy Sharp Social Icon Button -->
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label}
          class={`w-11 h-11 rounded-lg bg-gradient-to-b from-white/[0.10] via-white/[0.04] to-transparent border border-white/20 backdrop-blur-xl backdrop-saturate-150 text-slate-300 flex items-center justify-center transition-all duration-300 transform group-hover/social:-translate-y-1 active:scale-95 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3),0_8px_20px_rgba(0,0,0,0.3)] ${brand.btnHover}`}
        >
          {item.icon === 'github' && (
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          )}
          {item.icon === 'twitter' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          )}
          {item.icon === 'linkedin' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37h2.79V10.9H6.46M7.86 6.34a1.64 1.64 0 0 0-1.66 1.64 1.64 1.64 0 0 0 1.66 1.64 1.65 1.65 0 0 0 1.66-1.64 1.65 1.65 0 0 0-1.66-1.64Z" />
            </svg>
          )}
          {item.icon === 'youtube' && (
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          )}
          {item.icon === 'instagram' && (
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          )}
        </a>
      </div>
    );
  })}
</div>
