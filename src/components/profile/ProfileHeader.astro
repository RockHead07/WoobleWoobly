---
import { Image } from 'astro:assets';
import profileImage from '../../assets/images/profilePicture.png';
import { profile } from '../../data/links';
---

<header class="flex flex-col items-center text-center pt-6 pb-2 relative">
  <!-- Character Illustration (Borderless, natural character figure sitting behind the name) -->
  <div class="relative group flex flex-col items-center cursor-pointer select-none">
    <!-- Ambient subtle background glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-56 sm:h-56 rounded-full bg-gradient-to-tr from-indigo-400/20 via-purple-300/20 to-pink-300/15 blur-2xl opacity-60 group-hover:opacity-90 transition-opacity duration-500 pointer-events-none"></div>

    <!-- Character Image (No border, no card frame) -->
    <div class="relative z-0 transition-transform duration-500 ease-out group-hover:scale-105">
      <Image
        src={profileImage}
        alt={profile.name}
        class="w-48 sm:w-56 h-auto object-contain pointer-events-none"
        loading="eager"
      />
    </div>
  </div>

  <!-- Name & Handle (Text positioned in front of the character) -->
  <div class="space-y-1 relative z-10 -mt-6 sm:-mt-8 flex flex-col items-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-2xl bg-white/90 backdrop-blur-md shadow-sm border border-slate-100/80">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
        {profile.name}
      </h1>
      {profile.verified && (
        <span class="inline-flex items-center justify-center w-5 h-5 bg-blue-500 text-white rounded-full shadow-sm" title="Verified Creator">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 fill-current" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </span>
      )}
    </div>

    <p class="text-sm font-semibold text-indigo-600 pt-0.5">
      {profile.handle}
    </p>
  </div>

  <!-- Bio -->
  <p class="text-slate-600 text-sm sm:text-base max-w-md leading-relaxed px-4 pt-3 relative z-10">
    {profile.bio}
  </p>

  <!-- Location Badge (Optional) -->
  {profile.location && (
    <div class="inline-flex items-center gap-1.5 px-3 py-1 mt-3 rounded-full bg-white/80 border border-slate-200/80 text-xs font-medium text-slate-600 shadow-sm backdrop-blur-sm relative z-10">
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>{profile.location}</span>
    </div>
  )}
</header>
