---
import { Image } from 'astro:assets';
import profileImage from '../../assets/images/profilePicture.png';
import { profile } from '../../data/links';
---

<header class="flex flex-col items-center text-center pt-6 pb-2 relative">
  <!-- Character Illustration with Interactive Eye Tracking Pupils -->
  <div id="character-avatar-container" class="relative group flex flex-col items-center cursor-pointer select-none" title="Click me!">
    <!-- Ambient subtle background glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-56 sm:h-56 rounded-full bg-gradient-to-tr from-indigo-400/20 via-purple-300/20 to-pink-300/15 blur-2xl opacity-60 group-hover:opacity-90 transition-opacity duration-500 pointer-events-none"></div>

    <!-- Character Image & Eye Overlay Frame -->
    <div class="relative z-0 transition-transform duration-500 ease-out group-hover:scale-105 inline-block">
      <Image
        src={profileImage}
        alt={profile.name}
        class="w-48 sm:w-56 h-auto object-contain pointer-events-none block"
        loading="eager"
      />

      <!-- Interactive Eyes Overlay (Anchored accurately inside the white of the glasses lenses) -->
      <div class="absolute inset-0 pointer-events-none overflow-visible">
        <!-- Left Eye (Lens inner white center: ~17.4% X, ~34.2% Y) -->
        <div
          data-eye="left"
          class="absolute left-[17.4%] top-[34.2%] -translate-x-1/2 -translate-y-1/2 w-7 h-7 flex items-center justify-center pointer-events-none"
        >
          <div
            data-pupil="left"
            class="w-3 h-3 sm:w-3.5 sm:h-3.5 bg-slate-950 rounded-full relative shadow-sm will-change-transform transition-transform duration-75 ease-out flex items-center justify-center"
          >
            <!-- Catchlight sparkle -->
            <div class="absolute top-0.5 right-0.5 w-1 h-1 bg-white rounded-full"></div>
          </div>
        </div>

        <!-- Right Eye (Shifted slightly left towards center: ~39.5% X, ~36.0% Y) -->
        <div
          data-eye="right"
          class="absolute left-[39.5%] top-[35.25%] -translate-x-1/2 -translate-y-1/2 w-7 h-7 flex items-center justify-center pointer-events-none"
        >
          <div
            data-pupil="right"
            class="w-3 h-3 sm:w-3.5 sm:h-3.5 bg-slate-950 rounded-full relative shadow-sm will-change-transform transition-transform duration-75 ease-out flex items-center justify-center"
          >
            <!-- Catchlight sparkle -->
            <div class="absolute top-0.5 right-0.5 w-1 h-1 bg-white rounded-full"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Name & Handle (Text positioned in front of the character) -->
  <div class="space-y-1 relative z-10 -mt-6 sm:-mt-8 flex flex-col items-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-2xl bg-white/90 backdrop-blur-md shadow-sm border border-slate-100/80">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
        {profile.name}
      </h1>
      {profile.verified && (
        <span class="inline-flex items-center justify-center w-5 h-5 bg-blue-500 text-white rounded-full shadow-sm" title="Verified Creator">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 fill-current" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </span>
      )}
    </div>

    <p class="text-sm font-semibold text-indigo-600 pt-0.5">
      {profile.handle}
    </p>
  </div>

  <!-- Bio -->
  <p class="text-slate-600 text-sm sm:text-base max-w-md leading-relaxed px-4 pt-3 relative z-10">
    {profile.bio}
  </p>

  <!-- Location Badge (Optional) -->
  {profile.location && (
    <div class="inline-flex items-center gap-1.5 px-3 py-1 mt-3 rounded-full bg-white/80 border border-slate-200/80 text-xs font-medium text-slate-600 shadow-sm backdrop-blur-sm relative z-10">
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>{profile.location}</span>
    </div>
  )}
</header>

<script>
  function setupEyeTracking() {
    const leftEye = document.querySelector('[data-eye="left"]');
    const rightEye = document.querySelector('[data-eye="right"]');
    const leftPupil = document.querySelector('[data-pupil="left"]') as HTMLElement | null;
    const rightPupil = document.querySelector('[data-pupil="right"]') as HTMLElement | null;
    const avatarContainer = document.getElementById('character-avatar-container');

    if (!leftEye || !rightEye || !leftPupil || !rightPupil) return;

    let isSurprised = false;

    const handlePointerMove = (e: { clientX: number; clientY: number }) => {
      if (isSurprised) return;

      const leftRect = leftEye.getBoundingClientRect();
      const rightRect = rightEye.getBoundingClientRect();

      // Unified bridge midpoint for coherent gaze orientation across both eyes
      const bridgeX = (leftRect.left + rightRect.left) / 2 + leftRect.width / 2;
      const bridgeY = (leftRect.top + rightRect.top) / 2 + leftRect.height / 2;

      const dx = e.clientX - bridgeX;
      const dy = e.clientY - bridgeY;
      const gazeAngle = Math.atan2(dy, dx);
      const dist = Math.hypot(dx, dy);

      // Harmonized gaze offset factor
      const factor = Math.min(dist / 140, 1);
      const isLookingRight = Math.cos(gazeAngle) > 0;
      
      // Calibrated bounds:
      // Left eye:
      const leftMaxX = isLookingRight ? 2.6 : 4.0;
      const leftMaxY = 3.0;

      // Right eye: tight limit on right gaze to maintain comfortable white margin
      const rightMaxX = isLookingRight ? 2.0 : 3.6;
      const rightMaxY = 3.0;

      const leftOffsetX = Math.cos(gazeAngle) * leftMaxX * factor;
      const leftOffsetY = Math.sin(gazeAngle) * leftMaxY * factor;

      const rightOffsetX = Math.cos(gazeAngle) * rightMaxX * factor;
      const rightOffsetY = Math.sin(gazeAngle) * rightMaxY * factor;

      leftPupil.style.transform = `translate3d(${leftOffsetX.toFixed(2)}px, ${leftOffsetY.toFixed(2)}px, 0)`;
      rightPupil.style.transform = `translate3d(${rightOffsetX.toFixed(2)}px, ${rightOffsetY.toFixed(2)}px, 0)`;
    };

    window.addEventListener('mousemove', handlePointerMove, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (e.touches[0]) handlePointerMove(e.touches[0]);
    }, { passive: true });

    // Interactive surprise bounce reaction when clicked
    if (avatarContainer) {
      avatarContainer.addEventListener('click', () => {
        isSurprised = true;
        leftPupil.style.transform = 'scale(1.4)';
        rightPupil.style.transform = 'scale(1.4)';
        
        setTimeout(() => {
          leftPupil.style.transform = 'scale(1)';
          rightPupil.style.transform = 'scale(1)';
          isSurprised = false;
        }, 350);
      });
    }

    // Natural occasional micro-blink animation
    setInterval(() => {
      if (!isSurprised && Math.random() > 0.45) {
        const prevLeft = leftPupil.style.transform;
        const prevRight = rightPupil.style.transform;

        leftPupil.style.transform += ' scaleY(0.1)';
        rightPupil.style.transform += ' scaleY(0.1)';

        setTimeout(() => {
          leftPupil.style.transform = prevLeft;
          rightPupil.style.transform = prevRight;
        }, 120);
      }
    }, 4500);
  }

  setupEyeTracking();
  document.addEventListener('astro:page-load', setupEyeTracking);
</script>
