---
import { support } from '../data/links';
---

<section class="w-full pt-2">
  <!-- Solid White Card Container with Sharp Corners -->
  <div class="relative overflow-hidden rounded-md bg-white border border-[#D6E6F2] p-5 sm:p-6 text-center flex flex-col items-center gap-3.5 shadow-sm hover:shadow-md transition-shadow">
    
    <!-- Official Buy Me a Coffee Wordmark Logo -->
    <div class="relative z-10 flex justify-center select-none pt-0.5">
      <img
        src="/icons/bmc-logo.svg"
        alt="Buy me a coffee"
        class="h-7 sm:h-8 w-auto object-contain"
        loading="eager"
      />
    </div>

    <div class="space-y-1 relative z-10">
      <h3 class="text-base font-bold text-slate-900 tracking-tight flex items-center justify-center gap-1.5">
        <span>{support.title}</span>
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 font-medium max-w-sm leading-relaxed">
        {support.description}
      </p>
    </div>

    <!-- Official Buy Me a Coffee Vibrant Yellow (#FFDD00) 3D Tactile Push Button -->
    <div class="relative z-10 flex justify-center w-full max-w-xs pt-1">
      <a
        id="coffee-3d-btn"
        href={support.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group/btn relative inline-block w-full text-center focus:outline-none select-none cursor-pointer"
        aria-label="Buy me a coffee"
      >
        <!-- 3D Base / Extruded Bottom Shadow Layer -->
        <span class="absolute inset-0 w-full h-full bg-[#C99700] rounded-md translate-y-1.5 shadow-[0_4px_12px_rgba(201,151,0,0.35)] transition-transform duration-100 ease-out group-active/btn:translate-y-0.5"></span>
        
        <!-- 3D Top Cap Layer (Yellow #FFDD00) -->
        <span class="relative flex items-center justify-center gap-2.5 w-full py-3.5 px-6 rounded-md bg-gradient-to-b from-[#FFE833] to-[#FFDD00] border-t border-white/60 border-b border-[#C99700] text-slate-900 font-black text-xs sm:text-sm tracking-wider uppercase shadow-inner transform transition-transform duration-100 ease-out group-hover/btn:-translate-y-0.5 group-active/btn:translate-y-1">
          <!-- Buy Me a Coffee Cup SVG Icon -->
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#0D0C22" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
          <span class="font-extrabold tracking-widest text-[#0D0C22]">BUY ME A COFFEE</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  const setupCoffeeButton = () => {
    const btn = document.getElementById('coffee-3d-btn') as HTMLAnchorElement | null;
    if (!btn) return;

    btn.addEventListener('click', (e) => {
      const url = btn.href;
      if (url && !e.defaultPrevented) {
        // Native anchor target="_blank" opens the link in a new tab
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCoffeeButton);
  } else {
    setupCoffeeButton();
  }

  document.addEventListener('astro:page-load', setupCoffeeButton);
</script>
