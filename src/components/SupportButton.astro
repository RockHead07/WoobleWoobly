---
import { support } from '../data/links';
---

<section class="w-full pt-2">
  <div class="relative overflow-hidden rounded-lg bg-amber-50/80 border border-amber-200/90 p-5 sm:p-6 backdrop-blur-2xl backdrop-saturate-150 text-center flex flex-col items-center gap-3.5 shadow-[0_4px_25px_rgba(245,158,11,0.08),inset_0_1px_1.5px_0_rgba(255,255,255,1)]">
    
    <!-- Ambient warm glow behind button -->
    <div class="absolute -top-10 -right-10 w-28 h-28 bg-amber-400/20 rounded-full blur-2xl pointer-events-none"></div>

    <div class="space-y-1 relative z-10">
      <h3 class="text-sm font-bold text-amber-950 tracking-wide flex items-center justify-center gap-1.5">
        <span>☕</span>
        <span>{support.title}</span>
      </h3>
      <p class="text-xs text-amber-800/90 max-w-sm">
        {support.description}
      </p>
    </div>

    <!-- 3D Tactile Squircle Button Mount -->
    <div class="relative z-10 flex justify-center w-full max-w-xs">
      <a
        id="coffee-3d-btn"
        href={support.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block select-none cursor-pointer w-full focus:outline-none"
        aria-label="Buy me a coffee 3D button"
      >
        <!-- Rendered via 3D Squircle SVG Engine -->
      </a>
    </div>
  </div>
</section>

<script>
  function init3DButton() {
    const el = document.getElementById('coffee-3d-btn');
    if (!el) return;

    let p = 0; // Press state (0 = released, 1 = pressed)
    let w = 240;
    const u = 'coffee_3d';
    const hb = 'f59e0b'; // Amber-500 base
    const hd = 'b45309'; // Amber-700 deep shadow

    const S = (width: number, height: number, radius: number, x: number, y: number): string => {
      let path = '';
      for (let j = 0; j < 4; j++) {
        for (let i = 0; i < 31; i++) {
          const q = ((j + i / 30) * Math.PI) / 2;
          const c = Math.cos(q);
          const s = Math.sin(q);
          path +=
            (j || i ? 'L' : 'M') +
            (x +
              (c > 0 ? width - radius : radius) +
              Math.sign(c) * Math.pow(Math.abs(c), 0.6) * radius) +
            ' ' +
            (y +
              (s > 0 ? height - radius : radius) +
              Math.sign(s) * Math.pow(Math.abs(s), 0.6) * radius);
        }
      }
      return path + 'Z';
    };

    const color = (hex: string, pct: number, k: string) => `color-mix(in srgb, #${hex} ${pct}%, ${k})`;

    const render = () => {
      const hi = color(hb, 65, 'white');
      const sh = color(hd, 35, 'black');
      const label = 'BUY ME A COFFEE';

      const faceY = 4 + p * 6;
      const baseY = 12;
      const z = Math.min(0.5, 20 / w);
      const dy = 6 - p * 3;
      const std = 4 - p * 2;
      const op = 0.35;

      el.style.height = '62px';

      el.innerHTML = `
        <svg viewBox="0 0 ${w + 10} 62" style="width:100%;height:100%;overflow:visible" preserveAspectRatio="none">
          <defs>
            <filter id="b${u}" x="-100%" y="-100%" width="300%" height="300%">
              <feDropShadow dy="${dy}" stdDeviation="${std}" flood-color="${sh}" flood-opacity="${op}"/>
            </filter>
            <linearGradient id="g${u}" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="${color(hd, 60, 'white')}"/>
              <stop offset="${z}" stop-color="${color(hd, 85, 'white')}"/>
              <stop offset="${1 - z}" stop-color="${color(hd, 85, 'white')}"/>
              <stop offset="1" stop-color="${color(hd, 60, 'white')}"/>
            </linearGradient>
            <linearGradient id="faceGrad${u}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fbbf24"/>
              <stop offset="100%" stop-color="#f59e0b"/>
            </linearGradient>
          </defs>
          
          <!-- 3D Base Drop Shadow Layer -->
          <path d="${S(w, 42, 12, 5, baseY)}" fill="${color(hd, 60, 'black')}" filter="url(#b${u})"/>
          
          <!-- 3D Base Outer Bevel -->
          <path d="${S(w, 42, 12, 5, baseY)}" fill="${color(hd, 75, 'black')}" stroke="${color(hd, 45, 'black')}" stroke-width="1.2"/>
          
          <!-- 3D Extruded Layer Slices -->
          ${Array.from({ length: Math.max(0, baseY - faceY) })
            .map((_, k) => `<path d="${S(w, 42, 12, 5, faceY + 1 + k)}" fill="url(#g${u})"/>`)
            .join('')}
          
          <!-- 3D Top Cap / Face -->
          <path d="${S(w, 42, 12, 5, faceY)}" fill="url(#faceGrad${u})" stroke="${hi}" stroke-width="1.5"/>
          
          <!-- 3D Top Specular Shine Line -->
          <path d="${S(w - 6, 20, 8, 8, faceY + 2)}" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1" opacity="0.7"/>
          
          <!-- Icon & Bold Label -->
          <g transform="translate(${5 + w / 2}, ${21 + faceY})">
            <!-- Coffee Icon SVG -->
            <path d="M-68 -6 H-52 V2 C-52 4 -54 6 -57 6 H-63 C-66 6 -68 4 -68 2 Z M-52 -4 H-49 C-47.5 -4 -47.5 -1 -49 -1 H-52 Z M-70 8 H-48" 
                  fill="none" stroke="#090d16" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <text text-anchor="middle" dominant-baseline="central" fill="#090d16" dx="10"
                  style="pointer-events:none;font-weight:900;font-size:13.5px;letter-spacing:1px;font-family:system-ui, -apple-system, sans-serif;">
              ${label}
            </text>
          </g>
        </svg>
      `;
    };

    const press = (v: number) => {
      p = v;
      render();
    };

    el.addEventListener('pointerdown', () => press(1));
    el.addEventListener('pointerup', () => press(0));
    el.addEventListener('pointerleave', () => press(0));

    // Dynamic width calculation on resize
    const updateSize = () => {
      w = Math.max(180, el.offsetWidth - 10);
      render();
    };

    updateSize();
    window.addEventListener('resize', updateSize);
  }

  document.addEventListener('DOMContentLoaded', init3DButton);
  init3DButton();
</script>
