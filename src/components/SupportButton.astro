---
import { support } from '../data/links';
---

<section class="w-full pt-2">
  <div class="p-4 rounded-lg bg-amber-500/10 border border-amber-500/20 text-center flex flex-col items-center gap-3">
    <div class="space-y-1">
      <h3 class="text-sm font-bold text-amber-200">
        {support.title}
      </h3>
      <p class="text-xs text-amber-300/80 max-w-sm">
        {support.description}
      </p>
    </div>

    <a
      href={support.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-sm shadow-md shadow-amber-400/20 transition-all duration-200 transform hover:scale-105 active:scale-95"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM2 19h18v2H2z" />
      </svg>
      <span>{support.buttonText}</span>
    </a>
  </div>
</section>
