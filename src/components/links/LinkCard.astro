---
import { quickLinks } from '../../data/links';
---

<section class="w-full">
  <!-- Always 2 columns on all devices (mobile/android & desktop) -> 2x2 = 4 grid cards -->
  <div class="grid grid-cols-2 gap-2.5 sm:gap-3.5">
    {quickLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col justify-between p-3.5 sm:p-4.5 rounded-md bg-white border border-[#D6E6F2] hover:border-[#B9D7EA] transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden shadow-sm hover:shadow-[0_8px_24px_rgba(118,159,205,0.18)]"
      >
        <!-- Top bar inside card: Icon + Badge + Arrow -->
        <div class="relative z-10 flex items-center justify-between gap-1.5 sm:gap-2 mb-2.5 sm:mb-3">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-sm flex items-center justify-center border border-[#D6E6F2] bg-[#F7FBFC] text-[#769FCD] group-hover:bg-[#769FCD] group-hover:text-white group-hover:border-[#769FCD] transition-all duration-300 shadow-sm">
              {link.icon === 'globe' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              )}
              {link.icon === 'book-open' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {(link.icon === 'code' || link.icon === 'github') && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 98 96">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M41.6394 69.3848C29.0066 67.8535 20.1062 58.7617 20.1062 46.9902C20.1062 42.2051 21.8289 37.0371 24.7 33.5918C23.4558 30.4336 23.6472 23.7344 25.0828 20.959C28.9109 20.4805 34.0789 22.4902 37.1414 25.2656C40.7781 24.1172 44.6062 23.543 49.2957 23.543C53.9851 23.543 57.8132 24.1172 61.2585 25.1699C64.2253 22.4902 69.489 20.4805 73.3171 20.959C74.657 23.543 74.8484 30.2422 73.6042 33.4961C76.6667 37.1328 78.2937 42.0137 78.2937 46.9902C78.2937 58.7617 69.3933 67.6621 56.5691 69.2891C59.823 71.3945 62.0242 75.9883 62.0242 81.252L62.0242 91.2051C62.0242 94.0762 64.4167 95.7031 67.2878 94.5547C84.6101 87.9512 98.2 70.6289 98.2 49.1914C98.2 22.1074 76.1882 0 49.1042 0C22.0203 0 0.199951 22.1074 0.199951 49.1914C0.199951 70.4375 13.6941 88.0469 31.8777 94.6504C34.4617 95.6074 36.95 93.8848 36.95 91.3008L36.95 83.6445C35.6101 84.2188 33.8875 84.6016 32.3562 84.6016C26.0398 84.6016 22.3074 81.1563 19.6277 74.7441C18.575 72.1602 17.4265 70.6289 15.2253 70.3418C14.0769 70.2461 13.6941 69.7676 13.6941 69.1934C13.6941 68.0449 15.6082 67.1836 17.5222 67.1836C20.2976 67.1836 22.6902 68.9063 25.1785 72.4473C27.0925 75.2227 29.1023 76.4668 31.4949 76.4668C33.8875 76.4668 35.4187 75.6055 37.6199 73.4043C39.2468 71.7773 40.491 70.3418 41.6394 69.3848Z"/>
                </svg>
              )}
            </div>
            {link.badge && (
              <span class="text-[9px] sm:text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-sm bg-[#B9D7EA]/90 text-slate-800 border border-[#769FCD]/40 shadow-sm">
                {link.badge}
              </span>
            )}
          </div>

          <!-- Arrow icon with sharp style -->
          <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-sm bg-white border border-[#D6E6F2] flex items-center justify-center text-[#769FCD] group-hover:text-white group-hover:bg-[#769FCD] group-hover:border-[#769FCD] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shadow-sm shrink-0">
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </span>
        </div>

        <!-- Text details -->
        <div class="relative z-10">
          <h3 class="text-xs sm:text-sm md:text-base font-bold text-slate-900 group-hover:text-[#769FCD] transition-colors leading-snug">
            {link.title}
          </h3>
          {link.description && (
            <p class="text-[11px] sm:text-xs text-slate-500 mt-1 leading-tight sm:leading-snug line-clamp-2">
              {link.description}
            </p>
          )}
        </div>
      </a>
    ))}
  </div>
</section>
