---
import { quickLinks } from '../../data/links';
---

<section class="w-full">
  <!-- Always 2 columns on all devices (mobile/android & desktop) -> 2x2 = 4 grid cards -->
  <div class="grid grid-cols-2 gap-2.5 sm:gap-3.5">
    {quickLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col justify-between p-3.5 sm:p-4.5 rounded-md bg-white border border-[#ADC2A9]/60 hover:border-[#99A799] transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden shadow-sm hover:shadow-[0_8px_24px_rgba(153,167,153,0.2)]"
      >
        <!-- Top bar inside card: Icon + Badge + Arrow -->
        <div class="relative z-10 flex items-center justify-between gap-1.5 sm:gap-2 mb-2.5 sm:mb-3">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-sm flex items-center justify-center border border-[#ADC2A9]/60 bg-[#F9FBF7] text-[#99A799] group-hover:bg-[#99A799] group-hover:text-white group-hover:border-[#99A799] transition-all duration-300 shadow-sm">
              {link.icon === 'globe' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              )}
              {link.icon === 'book-open' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {link.icon === 'code' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
            </div>
            {link.badge && (
              <span class="text-[9px] sm:text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-sm bg-[#D3E4CD]/70 text-slate-800 border border-[#ADC2A9] shadow-sm">
                {link.badge}
              </span>
            )}
          </div>

          <!-- Arrow icon with sharp style -->
          <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-sm bg-white border border-[#ADC2A9]/60 flex items-center justify-center text-[#99A799] group-hover:text-white group-hover:bg-[#99A799] group-hover:border-[#99A799] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shadow-sm shrink-0">
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </span>
        </div>

        <!-- Text details -->
        <div class="relative z-10">
          <h3 class="text-xs sm:text-sm md:text-base font-bold text-slate-900 group-hover:text-[#99A799] transition-colors leading-snug">
            {link.title}
          </h3>
          {link.description && (
            <p class="text-[11px] sm:text-xs text-slate-500 mt-1 leading-tight sm:leading-snug line-clamp-2">
              {link.description}
            </p>
          )}
        </div>
      </a>
    ))}
  </div>
</section>
