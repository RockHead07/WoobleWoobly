---
import { quickLinks } from '../../data/links';
---

<section class="w-full">
  <!-- Always 2 columns on all devices (mobile/android & desktop) -> 2x2 = 4 grid cards -->
  <div class="grid grid-cols-2 gap-2.5 sm:gap-3.5">
    {quickLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class={`group relative flex flex-col justify-between p-3.5 sm:p-4.5 rounded-lg border transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden backdrop-blur-2xl backdrop-saturate-150 ${
          link.highlight
            ? 'bg-gradient-to-b from-white/95 via-indigo-50/60 to-white/90 border-indigo-200/90 hover:border-indigo-400 shadow-[0_4px_20px_rgba(99,102,241,0.08),inset_0_1px_1.5px_0_rgba(255,255,255,1)] hover:shadow-[0_14px_32px_rgba(99,102,241,0.18),inset_0_1px_2px_0_rgba(255,255,255,1)]'
            : 'bg-white/80 hover:bg-white/95 border-slate-200/90 hover:border-indigo-300 shadow-[0_4px_20px_rgba(0,0,0,0.03),inset_0_1px_1.5px_0_rgba(255,255,255,1)] hover:shadow-[0_12px_28px_rgba(99,102,241,0.12),inset_0_1px_2px_0_rgba(255,255,255,1)]'
        }`}
      >
        <!-- Glass specular highlight sheen -->
        <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/40 to-white/80 pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-300"></div>

        <!-- Subtle liquid wave reflection overlay -->
        <div class="absolute -top-10 -left-10 w-28 h-28 bg-indigo-500/5 rounded-full blur-xl pointer-events-none group-hover:scale-150 transition-transform duration-700"></div>

        <!-- Top bar inside card: Icon + Badge + Arrow -->
        <div class="relative z-10 flex items-center justify-between gap-1.5 sm:gap-2 mb-2.5 sm:mb-3">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <div class={`w-7 h-7 sm:w-9 sm:h-9 rounded-md flex items-center justify-center backdrop-blur-md border transition-all duration-300 ${
              link.highlight
                ? 'bg-indigo-50 border-indigo-200/80 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white group-hover:border-indigo-600 shadow-sm'
                : 'bg-slate-100/90 border-slate-200 text-slate-700 group-hover:bg-slate-900 group-hover:text-white group-hover:border-slate-900 shadow-sm'
            }`}>
              {link.icon === 'globe' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              )}
              {link.icon === 'book-open' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {link.icon === 'code' && (
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
            </div>
            {link.badge && (
              <span class={`text-[9px] sm:text-[10px] uppercase font-bold tracking-wider px-1.5 sm:px-2.5 py-0.5 rounded-md backdrop-blur-md border ${
                link.highlight
                  ? 'bg-indigo-100/90 text-indigo-700 border-indigo-200 shadow-sm'
                  : 'bg-emerald-100/90 text-emerald-700 border-emerald-200 shadow-sm'
              }`}>
                {link.badge}
              </span>
            )}
          </div>

          <!-- Arrow icon with frosted button style -->
          <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-md bg-slate-100/80 border border-slate-200 flex items-center justify-center text-slate-500 group-hover:text-slate-900 group-hover:bg-slate-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shadow-sm shrink-0">
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </span>
        </div>

        <!-- Text details -->
        <div class="relative z-10">
          <h3 class="text-xs sm:text-sm md:text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors leading-snug">
            {link.title}
          </h3>
          {link.description && (
            <p class="text-[11px] sm:text-xs text-slate-500 mt-1 leading-tight sm:leading-snug line-clamp-2">
              {link.description}
            </p>
          )}
        </div>
      </a>
    ))}
  </div>
</section>
