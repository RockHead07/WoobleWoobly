---
import { quickLinks } from '../../data/links';
---

<section class="w-full">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
    {quickLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class={`group relative flex flex-col justify-between p-4.5 rounded-lg border transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden backdrop-blur-2xl backdrop-saturate-150 ${
          link.highlight
            ? 'bg-gradient-to-b from-white/[0.14] via-white/[0.06] to-indigo-900/20 border-white/30 hover:border-white/50 shadow-[inset_0_1px_1.5px_0_rgba(255,255,255,0.5),0_12px_36px_-6px_rgba(99,102,241,0.25)] hover:shadow-[inset_0_1px_2px_0_rgba(255,255,255,0.7),0_18px_45px_-5px_rgba(99,102,241,0.35)]'
            : 'bg-gradient-to-b from-white/[0.10] via-white/[0.04] to-transparent border-white/20 hover:border-white/40 shadow-[inset_0_1px_1.5px_0_rgba(255,255,255,0.35),0_10px_30px_-5px_rgba(0,0,0,0.45)] hover:shadow-[inset_0_1px_2px_0_rgba(255,255,255,0.55),0_16px_40px_-5px_rgba(0,0,0,0.55)]'
        }`}
      >
        <!-- Glass specular highlight sheen -->
        <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.04] to-white/[0.12] pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>

        <!-- Subtle liquid wave reflection overlay -->
        <div class="absolute -top-10 -left-10 w-28 h-28 bg-white/10 rounded-full blur-xl pointer-events-none group-hover:scale-150 transition-transform duration-700"></div>

        <!-- Top bar inside card: Icon + Badge + Arrow -->
        <div class="relative z-10 flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <div class={`w-9 h-9 rounded-md flex items-center justify-center backdrop-blur-md border transition-all duration-300 ${
              link.highlight
                ? 'bg-indigo-500/25 border-indigo-400/40 text-indigo-200 group-hover:bg-indigo-500 group-hover:text-white group-hover:border-indigo-300 shadow-[inset_0_1px_1px_rgba(255,255,255,0.4)]'
                : 'bg-white/10 border-white/20 text-white/90 group-hover:bg-white/20 group-hover:text-white group-hover:border-white/35 shadow-[inset_0_1px_1px_rgba(255,255,255,0.25)]'
            }`}>
              {link.icon === 'globe' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              )}
              {link.icon === 'book-open' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {link.icon === 'code' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
            </div>
            {link.badge && (
              <span class={`text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-md backdrop-blur-md border ${
                link.highlight
                  ? 'bg-indigo-500/25 text-indigo-200 border-indigo-400/35 shadow-[inset_0_1px_1px_rgba(255,255,255,0.3)]'
                  : 'bg-emerald-500/20 text-emerald-200 border-emerald-400/35 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)]'
              }`}>
                {link.badge}
              </span>
            )}
          </div>

          <!-- Arrow icon with frosted circle button style -->
          <span class="w-7 h-7 rounded-md bg-white/[0.07] border border-white/15 flex items-center justify-center text-white/70 group-hover:text-white group-hover:bg-white/20 group-hover:border-white/30 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200 shadow-sm">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </span>
        </div>

        <!-- Text details -->
        <div class="relative z-10">
          <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-white/95 transition-colors drop-shadow-sm">
            {link.title}
          </h3>
          {link.description && (
            <p class="text-xs text-slate-300 mt-1 leading-snug line-clamp-2">
              {link.description}
            </p>
          )}
        </div>
      </a>
    ))}
  </div>
</section>
