---
import { cta } from '../../data/links';
---

<section class="w-full">
  <!-- Solid White Card with Sharp Corners & Pastel Blue Accents -->
  <div class="relative overflow-hidden rounded-md bg-white border border-[#D6E6F2] p-5 sm:p-6 shadow-sm hover:shadow-md transition-shadow">
    <div class="relative z-10 flex flex-col space-y-3.5">
      <!-- Badge Row -->
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-sm bg-[#B9D7EA]/90 border border-[#769FCD]/40 text-xs font-bold text-slate-800">
          {cta.badge}
        </span>
        {cta.price && (
          <div class="flex items-baseline gap-1.5">
            <span class="text-lg font-black text-slate-900">{cta.price}</span>
            {cta.originalPrice && (
              <span class="text-xs text-slate-500 line-through">{cta.originalPrice}</span>
            )}
          </div>
        )}
      </div>

      <!-- Title & Subtitle -->
      <div>
        <h2 class="text-base sm:text-lg font-extrabold text-slate-900 leading-tight flex items-center gap-1.5">
          <span>{cta.title}</span>
          <img
            src="/icons/gigs-sticker.gif"
            alt="sticker"
            class="w-6 h-6 sm:w-7 sm:h-7 object-contain inline-block -mt-0.5 select-none pointer-events-none"
            loading="eager"
          />
        </h2>
        <p class="text-xs sm:text-sm font-bold text-[#769FCD] mt-0.5">
          {cta.subtitle}
        </p>
      </div>

      <!-- Description -->
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
        {cta.description}
      </p>

      <!-- CTA Button with Sharp Radius -->
      <a
        href={cta.buttonUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-md font-bold text-sm text-white bg-[#769FCD] hover:bg-[#648ebc] shadow-sm shadow-[#769FCD]/20 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
      >
        <span>{cta.buttonText}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
