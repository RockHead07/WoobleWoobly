---
import { connect } from '../../data/links';

const targetEndpoint = connect.endpointUrl || 'https://formsubmit.co/ajax/dana.bagus07@gmail.com';
const targetEmail = connect.targetEmail || 'dana.bagus07@gmail.com';
---

<section class="w-full">
  <!-- Solid White Card with Sharp Corners & Pastel Blue Accents -->
  <div class="relative overflow-hidden rounded-md bg-white border border-[#D6E6F2] p-5 sm:p-6 shadow-sm hover:shadow-md transition-shadow">
    
    <!-- Top Header of Connect section -->
    <div class="flex items-center gap-2.5 mb-2">
      <div class="w-8 h-8 rounded-sm bg-[#F7FBFC] border border-[#D6E6F2] text-[#769FCD] flex items-center justify-center shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </div>
      <h2 class="text-base font-bold text-slate-900 tracking-tight">
        {connect.title}
      </h2>
    </div>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-slate-600 mb-4 leading-relaxed font-medium">
      {connect.description}
    </p>

    <!-- Connect Form with Email & Message Fields -->
    <form id="connect-form" data-endpoint={targetEndpoint} data-email={targetEmail} class="flex flex-col space-y-3">
      <!-- Email Field -->
      <div>
        <label for="connect-email" class="block text-xs font-bold text-slate-700 mb-1">
          Email Address
        </label>
        <input
          id="connect-email"
          name="email"
          type="email"
          required
          placeholder={connect.emailPlaceholder}
          class="w-full bg-[#F7FBFC] border border-[#D6E6F2] focus:border-[#769FCD] focus:bg-white rounded-md px-3.5 py-2.5 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#769FCD] transition-all shadow-sm"
        />
      </div>

      <!-- Message Field -->
      <div>
        <label for="connect-message" class="block text-xs font-bold text-slate-700 mb-1">
          Your Message
        </label>
        <textarea
          id="connect-message"
          name="message"
          rows="2"
          required
          placeholder={connect.messagePlaceholder}
          class="w-full bg-[#F7FBFC] border border-[#D6E6F2] focus:border-[#769FCD] focus:bg-white rounded-md px-3.5 py-2.5 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#769FCD] transition-all shadow-sm resize-none"
        ></textarea>
      </div>

      <!-- Status Alerts -->
      <div id="connect-status" class="hidden text-xs rounded-md p-3 font-medium transition-all"></div>

      <!-- Submit Button with Sharp Radius -->
      <button
        id="connect-submit-btn"
        type="submit"
        class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-md font-bold text-xs sm:text-sm text-white bg-[#769FCD] hover:bg-[#648ebc] shadow-sm shadow-[#769FCD]/20 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer disabled:opacity-70 disabled:cursor-not-allowed"
      >
        <span id="btn-text">{connect.buttonText}</span>
        <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>

      <!-- Direct Mailto Helper -->
      <div class="text-center pt-1">
        <a
          href={`mailto:${targetEmail}?subject=Inquiry%20via%20Bio-Link`}
          class="text-[11px] font-semibold text-slate-500 hover:text-[#769FCD] transition-colors"
        >
          Or send directly to <span class="underline underline-offset-2">{targetEmail}</span> ↗
        </a>
      </div>
    </form>
  </div>
</section>

<script>
  const setupConnectForm = () => {
    const form = document.getElementById('connect-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('connect-status');
    const submitBtn = document.getElementById('connect-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');

    if (!form || !statusEl || !submitBtn || !btnText) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.getAttribute('data-endpoint') || 'https://formsubmit.co/ajax/dana.bagus07@gmail.com';
      const targetEmail = form.getAttribute('data-email') || 'dana.bagus07@gmail.com';

      const emailInput = document.getElementById('connect-email') as HTMLInputElement | null;
      const messageInput = document.getElementById('connect-message') as HTMLTextAreaElement | null;

      const email = emailInput?.value.trim();
      const message = messageInput?.value.trim();

      if (!email || !message) return;

      // Loading state
      submitBtn.disabled = true;
      btnText.innerText = 'Sending message...';
      statusEl.className = 'hidden';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            email: email,
            message: message,
            _subject: `New Message from ${email} (WoobleWoobly Bio-Link)`,
            _template: 'table',
          }),
        });

        if (response.ok) {
          statusEl.className = 'block bg-[#F7FBFC] border border-[#B9D7EA] text-[#769FCD] p-3 rounded-md text-xs font-bold text-center';
          statusEl.innerHTML = `✨ Message sent successfully! I will reply to <strong>${email}</strong> soon.`;
          form.reset();
        } else {
          throw new Error('Failed to send');
        }
      } catch (err) {
        statusEl.className = 'block bg-rose-50 border border-rose-200 text-rose-700 p-3 rounded-md text-xs font-medium text-center';
        statusEl.innerHTML = `⚠️ Failed to send via form. <a href="mailto:${targetEmail}?subject=Direct%20Inquiry&body=${encodeURIComponent(message)}" class="underline font-bold">Click here to send directly via email ↗</a>`;
      } finally {
        submitBtn.disabled = false;
        btnText.innerText = 'Send Message';
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupConnectForm);
  } else {
    setupConnectForm();
  }

  document.addEventListener('astro:page-load', setupConnectForm);
</script>
