---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const avatarId = 'floating-avatar-widget';
---

<div
  id={avatarId}
  class={`fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end select-none pointer-events-auto ${className}`}
>
  <!-- Interactive speech bubble / greeting -->
  <div
    data-speech-bubble
    class="mb-2 mr-1 bg-white/95 backdrop-blur-xl border border-indigo-200/90 px-3.5 py-1.5 rounded-2xl shadow-xl text-[11px] sm:text-xs font-bold text-slate-800 flex items-center gap-1.5 transition-transform duration-200 cursor-pointer shadow-indigo-500/10 hover:scale-105"
  >
    <span data-speech-text>Hai! Semangat ya! ✨</span>
    <span data-speech-emoji class="text-sm">(=^･ω･^=)</span>
  </div>

  <!-- Avatar container -->
  <div
    data-avatar-head
    class="relative group cursor-pointer transition-all duration-300 transform hover:scale-110 active:scale-95"
    title="Click me for a 3D reaction!"
  >
    <!-- Ambient glowing aura -->
    <div class="absolute -inset-2.5 bg-gradient-to-r from-pink-400 via-purple-400 to-indigo-400 rounded-full blur-md opacity-70 group-hover:opacity-100 group-hover:blur-lg transition duration-300"></div>

    <!-- 3D Avatar Badge Frame (Circular Three.js Canvas Container) -->
    <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-tr from-slate-900 via-indigo-950 to-purple-950 shadow-2xl border-2 border-pink-400/50 flex items-center justify-center overflow-hidden">
      <!-- Three.js Canvas Mounting Node -->
      <div data-avatar-canvas class="w-full h-full flex items-center justify-center"></div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeUp {
    0% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(0.8);
    }
    100% {
      opacity: 0;
      transform: translate3d(0, -45px, 0) scale(1.3);
    }
  }

  .animate-fade-up {
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  import { init3DAvatar } from './avatar-3d';

  const setupAvatar = () => {
    init3DAvatar('floating-avatar-widget');
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAvatar);
  } else {
    setupAvatar();
  }

  document.addEventListener('astro:page-load', setupAvatar);
</script>
