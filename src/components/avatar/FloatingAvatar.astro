---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const avatarId = 'floating-avatar-widget';
---

<div
  id={avatarId}
  class={`fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end select-none pointer-events-auto ${className}`}
>
  <!-- Avatar container -->
  <div
    data-avatar-head
    class="relative group cursor-pointer transition-all duration-300 transform hover:scale-110 active:scale-95"
    title="Click me for a 3D reaction!"
  >
    <!-- Ambient glowing aura in palette blue -->
    <div class="absolute -inset-2.5 bg-[#B9D7EA]/60 rounded-full blur-md opacity-70 group-hover:opacity-100 group-hover:blur-lg transition duration-300"></div>

    <!-- 3D Avatar Badge Frame (Circular Three.js Canvas Container) -->
    <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-tr from-[#D6E6F2] via-[#F7FBFC] to-[#D6E6F2] shadow-xl border-2 border-[#769FCD]/60 flex items-center justify-center overflow-hidden">
      <!-- Three.js Canvas Mounting Node -->
      <div data-avatar-canvas class="w-full h-full flex items-center justify-center"></div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeUp {
    0% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(0.8);
    }
    100% {
      opacity: 0;
      transform: translate3d(0, -45px, 0) scale(1.3);
    }
  }

  .animate-fade-up {
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  import { init3DAvatar } from './avatar-3d';

  const setupAvatar = () => {
    init3DAvatar('floating-avatar-widget');
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAvatar);
  } else {
    setupAvatar();
  }

  document.addEventListener('astro:page-load', setupAvatar);
</script>
