---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const avatarId = 'floating-avatar-widget';
---

<div
  id={avatarId}
  class={`fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end select-none pointer-events-auto ${className}`}
>
  <!-- Interactive speech bubble / greeting -->
  <div class="mb-1.5 mr-1 bg-slate-900/90 backdrop-blur-md border border-slate-700/80 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-2xl shadow-xl text-[11px] sm:text-xs font-semibold text-slate-200 flex items-center gap-1.5 animate-bounce [animation-duration:3s]">
    <span>Looking around!</span>
    <span class="text-sm">👀</span>
  </div>

  <!-- Avatar container -->
  <div
    data-avatar-head
    class="relative group cursor-pointer transition-transform duration-300 transform hover:scale-110 active:scale-95"
  >
    <!-- Ambient glow behind avatar -->
    <div class="absolute -inset-1.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full blur-md opacity-60 group-hover:opacity-100 transition duration-300"></div>

    <!-- Avatar Head (Cute 2D Creature/Character) -->
    <div class="relative w-16 h-16 sm:w-22 sm:h-22 rounded-full bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 p-0.5 sm:p-1 shadow-2xl border-2 border-white/20 flex items-center justify-center overflow-hidden">
      <!-- Head Body SVG -->
      <svg class="w-full h-full" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Cute ear puffs -->
        <circle cx="22" cy="22" r="12" fill="#8b5cf6" fill-opacity="0.8" />
        <circle cx="78" cy="22" r="12" fill="#ec4899" fill-opacity="0.8" />
        <circle cx="22" cy="22" r="6" fill="#f472b6" fill-opacity="0.5" />
        <circle cx="78" cy="22" r="6" fill="#f472b6" fill-opacity="0.5" />

        <!-- Face gradient -->
        <circle cx="50" cy="50" r="42" fill="url(#faceGradient)" />

        <!-- Cheeks -->
        <circle cx="28" cy="62" r="7" fill="#f43f5e" fill-opacity="0.4" filter="blur(1px)" />
        <circle cx="72" cy="62" r="7" fill="#f43f5e" fill-opacity="0.4" filter="blur(1px)" />

        <!-- Cute Smile -->
        <path d="M43 65C45 68 55 68 57 65" stroke="#1e1b4b" stroke-width="3" stroke-linecap="round" />

        <defs>
          <linearGradient id="faceGradient" x1="15" y1="15" x2="85" y2="85" gradientUnits="userSpaceOnUse">
            <stop stop-color="#e0e7ff" />
            <stop offset="0.6" stop-color="#c7d2fe" />
            <stop offset="1" stop-color="#a5b4fc" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Eyes Overlay Layer -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <!-- Left Eye Socket -->
        <div
          data-eye="left"
          class="absolute left-[28%] top-[38%] w-4.5 h-5.5 sm:w-5 sm:h-6 bg-white rounded-full border-2 border-slate-900/40 shadow-inner flex items-center justify-center overflow-hidden"
        >
          <!-- Left Pupil -->
          <div
            data-pupil="left"
            class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[#0f172a] rounded-full relative will-change-transform flex items-start justify-end p-0.5"
          >
            <!-- Catchlight -->
            <div class="w-1 h-1 bg-white rounded-full"></div>
          </div>
        </div>

        <!-- Right Eye Socket -->
        <div
          data-eye="right"
          class="absolute right-[28%] top-[38%] w-4.5 h-5.5 sm:w-5 sm:h-6 bg-white rounded-full border-2 border-slate-900/40 shadow-inner flex items-center justify-center overflow-hidden"
        >
          <!-- Right Pupil -->
          <div
            data-pupil="right"
            class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[#0f172a] rounded-full relative will-change-transform flex items-start justify-end p-0.5"
          >
            <!-- Catchlight -->
            <div class="w-1 h-1 bg-white rounded-full"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initAvatar } from './avatar-idle';

  document.addEventListener('DOMContentLoaded', () => {
    initAvatar('floating-avatar-widget');
  });

  // Also support Astro view transitions / client hydrations
  initAvatar('floating-avatar-widget');
</script>
