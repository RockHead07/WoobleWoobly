---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Bagus Insan Pradana (@rockhead07) — Links & Portfolio",
  description = "Creative developer & UI designer crafting playful digital experiences, 3D web experiments, and modern apps.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://bagus-insan-pradana.vercel.app");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="relative min-h-screen bg-[#fafbfc] text-slate-900 overflow-x-hidden selection:bg-indigo-500 selection:text-white">
    <!-- Ambient clean background glows for frosted glass refraction -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <!-- Top header glow -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-gradient-to-br from-indigo-200/45 via-sky-200/40 to-purple-200/35 rounded-full blur-[110px]"></div>
      
      <!-- Mid-page liquid glow specifically positioned behind the grid cards -->
      <div class="absolute top-[32%] left-[10%] w-[450px] h-[450px] bg-gradient-to-tr from-sky-200/40 via-indigo-200/35 to-teal-100/30 rounded-full blur-[100px]"></div>
      <div class="absolute top-[40%] right-[5%] w-[420px] h-[420px] bg-gradient-to-bl from-purple-200/40 via-pink-200/35 to-indigo-100/30 rounded-full blur-[100px]"></div>
      
      <!-- Bottom page glow -->
      <div class="absolute bottom-10 left-1/3 w-[500px] h-[500px] bg-gradient-to-t from-blue-200/35 via-indigo-100/30 to-transparent rounded-full blur-[120px]"></div>
      
      <!-- Subtle dot grid pattern on white background -->
      <div class="absolute inset-0 bg-[radial-gradient(#94a3b8_1.3px,transparent_1.3px)] [background-size:22px_22px] opacity-40"></div>
    </div>

    <slot />
  </body>
</html>
